node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Environment secrets
.env
.env.local
.env.*.local

# Runtime file uploads (never commit uploaded data)
uploads/*
!uploads/.gitkeep

# Runtime metadata records (may contain private file information)
metadata/*.json
metadata/.*.tmp
!metadata/.gitkeep

# SQLite runtime database (contains private file metadata)
data/*.sqlite*
data/*.db*
!data/.gitkeep
