# OB Transfer environment configuration
# Copy this file to .env and replace ACCESS_PASSWORD with a strong private password.
# Never commit .env or any file containing real credentials.

ACCESS_PASSWORD=CHANGE_THIS_TO_A_STRONG_PRIVATE_PASSWORD
APP_URL=http://localhost:3000
NODE_ENV=development

# Resource limits
MAX_FILE_SIZE_BYTES=10737418240
MAX_STORAGE_BYTES=53687091200
MAX_FILES=1000

# Development tooling
DISABLE_HMR=false

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional development tunnel configuration (use your current exact ngrok hostname).
# Leave blank when you are not using a tunnel.
NGROK_HOST=
ADDITIONAL_ALLOWED_ORIGINS=
